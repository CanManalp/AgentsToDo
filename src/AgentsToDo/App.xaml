<Application x:Class="AgentsToDo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- Palette: kraft board, cool paper, school-notebook rules, ballpoint ink. -->
        <SolidColorBrush x:Key="BoardEdgeBrush" Color="#6E4A2A"/>
        <LinearGradientBrush x:Key="BoardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A8774A" Offset="0"/>
            <GradientStop Color="#9A6B3F" Offset="0.55"/>
            <GradientStop Color="#8A5D35" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PaperBrush" Color="#F6F7F5"/>
        <SolidColorBrush x:Key="RuleBrush" Color="#C7D6E6"/>
        <SolidColorBrush x:Key="MarginBrush" Color="#E59A9A"/>
        <SolidColorBrush x:Key="InkBrush" Color="#233C8C"/>
        <SolidColorBrush x:Key="RedInkBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="PencilBrush" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="InkWashBrush" Color="#1A233C8C"/>

        <FontFamily x:Key="HandFont">Segoe Print, Segoe UI</FontFamily>

        <!-- One ring every 26 px: a punched hole and a metal loop that runs into it. -->
        <DrawingBrush x:Key="RingsBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,26,48" ViewportUnits="Absolute"
                      Viewbox="0,0,26,48" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,26,48"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <RadialGradientBrush GradientOrigin="0.5,0.3">
                                <GradientStop Color="#1E140C" Offset="0.55"/>
                                <GradientStop Color="#5A4330" Offset="1"/>
                            </RadialGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="13,40" RadiusX="5.5" RadiusY="5.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#33000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="12.5,5,5,35" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6B7178" Offset="0"/>
                                <GradientStop Color="#F4F6F8" Offset="0.4"/>
                                <GradientStop Color="#B9BEC4" Offset="0.72"/>
                                <GradientStop Color="#5E646A" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="10.5,2,5,38" RadiusX="2.5" RadiusY="2.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Ruled paper: one line every 28 px, the height of one list row. -->
        <DrawingBrush x:Key="LinesBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,8,28" ViewportUnits="Absolute"
                      Viewbox="0,0,8,28" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,28"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource RuleBrush}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,27,8,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Round buttons with pen-stroke icons; the icon strokes follow Foreground. -->
        <!-- The note is used with the mouse, so its controls never take keyboard focus
             (otherwise Windows draws a dotted focus box after every click on some setups). -->
        <Style x:Key="PadButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Wash" Background="Transparent" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="{StaticResource InkWashBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="#33233C8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource PadButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource RedInkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Group heading: the whole row is the button. -->
        <Style x:Key="HeadingButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A drawn box; the tick overshoots it the way a quick pen tick does. -->
        <Style x:Key="InkCheck" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Border x:Name="Box" Width="13" Height="13" Margin="0,3,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource InkBrush}" BorderThickness="1.4" CornerRadius="2"
                                    Background="{StaticResource PaperBrush}"/>
                            <Path x:Name="Tick" Data="M4.5,11 L8.5,15.5 L18,1.5" Visibility="Collapsed"
                                  Stroke="{StaticResource InkBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PencilBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource InkWashBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A written line made selectable: no box around it, and the selection is a highlighter stroke. -->
        <Style x:Key="SelectableLine" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="SelectionBrush" Value="#F2C230"/>
            <Setter Property="SelectionOpacity" Value="0.55"/>
            <Setter Property="SelectionTextBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin pencil-line scroll bar. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#40233C8C" CornerRadius="2" Margin="1,4,2,4"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltips look like a small paper slip and wrap long text. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BoardEdgeBrush}"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="360"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
